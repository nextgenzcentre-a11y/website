{
  "redirects": [
    {
      "source": "/accommodation",
      "destination": "/services/student-accommodation-malaysia.html",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/visas",
      "destination": "/guides/malaysia-student-visa-emgs-guide.html",
      "permanent": true
    },
    {
      "source": "/visas/malaysia-student-visa-emgs-guide.html",
      "destination": "/guides/malaysia-student-visa-emgs-guide.html",
      "permanent": true
    },
    {
      "source": "/universities",
      "destination": "/#universities",
      "permanent": true
    },
    {
      "source": "/universities.html",
      "destination": "/#universities",
      "permanent": true
    },
    {
      "source": "/faq.html",
      "destination": "/#faq",
      "permanent": true
    },
    {
      "source": "/services/",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/visas/",
      "destination": "/guides/malaysia-student-visa-emgs-guide.html",
      "permanent": true
    },
    {
      "source": "/universities/",
      "destination": "/#universities",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/accommodation-images/:id.jpg",
      "destination": "https://nextgenz-accommodation-portal.vercel.app/api/accommodation?part=published-image&id=:id"
    },
    {
      "source": "/admin/accommodation.html",
      "destination": "https://nextgenz-accommodation-portal.vercel.app/admin/accommodation.html"
    },
    {
      "source": "/api/accommodation",
      "destination": "https://nextgenz-accommodation-portal.vercel.app/api/accommodation"
    },
    {
      "source": "/services/accommodation/:asset*",
      "destination": "https://nextgenz-accommodation-portal.vercel.app/services/accommodation/:asset*"
    },
    {
      "source": "/student",
      "destination": "/portal-app.html"
    },
    {
      "source": "/studentportal",
      "destination": "/portal-app.html"
    },
    {
      "source": "/agent",
      "destination": "/portal-app.html"
    },
    {
      "source": "/agentportal",
      "destination": "/portal-app.html"
    },
    {
      "source": "/registerasstudent",
      "destination": "/portal-app.html"
    },
    {
      "source": "/registerasagent",
      "destination": "/portal-app.html"
    },
    {
      "source": "/registerstudent",
      "destination": "/portal-app.html"
    },
    {
      "source": "/registeragent",
      "destination": "/portal-app.html"
    }
  ],
  "buildCommand": "npm ci --prefix scripts/public-build --no-audit --no-fund && npm run --prefix scripts/public-build build && rm -rf scripts/public-build/node_modules",
  "outputDirectory": "."
}
