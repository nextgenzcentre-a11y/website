{
  "redirects": [
    {
      "source": "/services",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/visas",
      "destination": "/guides/malaysia-student-visa-emgs-guide.html",
      "permanent": true
    },
    {
      "source": "/visas/malaysia-student-visa-emgs-guide.html",
      "destination": "/guides/malaysia-student-visa-emgs-guide.html",
      "permanent": true
    },
    {
      "source": "/universities",
      "destination": "/#universities",
      "permanent": true
    },
    {
      "source": "/universities.html",
      "destination": "/#universities",
      "permanent": true
    },
    {
      "source": "/faq.html",
      "destination": "/#faq",
      "permanent": true
    },
    {
      "source": "/services/",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/visas/",
      "destination": "/guides/malaysia-student-visa-emgs-guide.html",
      "permanent": true
    },
    {
      "source": "/universities/",
      "destination": "/#universities",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/student",
      "destination": "/index.html"
    },
    {
      "source": "/studentportal",
      "destination": "/index.html"
    },
    {
      "source": "/agent",
      "destination": "/index.html"
    },
    {
      "source": "/agentportal",
      "destination": "/index.html"
    },
    {
      "source": "/registerasstudent",
      "destination": "/index.html"
    },
    {
      "source": "/registerasagent",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm ci --prefix scripts/public-build --no-audit --no-fund && node scripts/public-build/build.cjs && node scripts/public-build/prepare-ads.cjs && rm -rf scripts/public-build/node_modules",
  "outputDirectory": "."
}
